{
  "name": "esp32s3-fc-configurator",
  "productName": "ESP32-S3 FC Configurator",
  "version": "0.1.0",
  "description": "Desktop configurator for the ESP32-S3 flight controller (connects to the board's built-in web UI).",
  "main": "main.js",
  "author": "alsdroppers123",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/host.test.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.alsdroppers.esp32s3fc.configurator",
    "productName": "ESP32-S3 FC Configurator",
    "files": ["main.js", "preload.js", "host.js", "connect.html", "connect.js", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"] },
    "linux": { "target": ["AppImage"], "category": "Utility" },
    "mac": { "target": ["dmg"], "category": "public.app-category.utilities" }
  }
}
